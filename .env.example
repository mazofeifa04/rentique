# Copy to .env and edit. Compose reads it automatically.
POSTGRES_PASSWORD=change-me-before-going-live
APP_PORT=3000

# Demo data. Set SEED_DEMO=false for an empty marketplace.
SEED_DEMO=true
DEMO_LOGIN=true
DEMO_PASSWORD=demo1234

# Number of reverse proxies in front of the app (Railway, Render, Caddy, Nginx = 1)
TRUST_PROXY=1

# Super admin. Set both for a real deployment. With ADMIN_EMAIL set, the demo admin
# (admin@demo.rentique) is NOT created. With it empty and SEED_DEMO=true, the demo admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
